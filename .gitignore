# Venvs
venv/
.venv/

# Env vars and the app's config file: keys, never on GitHub
.env
.env.local
.env.*.local
config.env

# Python
__pycache__/

# logs and the app's outputs (run records, result files)
logs/
output/

# Files
*.pdf
*.html
*.xml
*.json
*.csv
*.md
!README.md
!demo/index.html
!app/INSTALL.md
!app/pages/*.html

# Folders
data/screenshots_invoice_lists/*
!data/screenshots_invoice_lists/.gitkeep
old/
evaluation/results

# Tests
tests/

# PyInstaller: the intermediate build and the plain-folder variant stay out.
# The .app in dist/ goes to GitHub whole, so the file rules above do not apply inside it.
build/
dist/Fakturaassistent/
!dist/Fakturaassistent.app/**

# macOS, last so it also wins inside the .app
.DS_Store
